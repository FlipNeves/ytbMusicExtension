{
    "manifest_version": 3,
    "name": "Focus Music Player",
    "version": "1.1.0",
    "description": "Focus Music Player: Experiência imersiva para YouTube Music com modo foco",
    "minimum_chrome_version": "111",
    "icons": {
        "16": "icon48.png",
        "48": "icon48.png",
        "96": "icon96.png",
        "128": "icon.png"
    },
    "action": {
        "default_title": "Abrir YouTube Music",
        "default_icon": {
            "16": "icon48.png",
            "48": "icon48.png",
            "128": "icon.png"
        }
    },
    "background": {
        "service_worker": "assets/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://music.youtube.com/*"
            ],
            "css": [
                "assets/content.css"
            ],
            "js": [
                "assets/content.js"
            ]
        },
        {
            "matches": [
                "https://music.youtube.com/*"
            ],
            "js": [
                "interceptor.js"
            ],
            "world": "MAIN",
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "tabs"
    ]
}
